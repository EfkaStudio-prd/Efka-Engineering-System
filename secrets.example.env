# Copy to your shell profile or set as OS environment variables.
# NEVER commit real values. The gate (core/scripts/scan-secrets.ps1) blocks them.

# 9Router gateway API key — dashboard http://127.0.0.1:20128 -> API Keys
EFKA_9ROUTER_KEY=

# Research MCP servers (only the ones you actually enable)
FIRECRAWL_API_KEY=
TAVILY_API_KEY=
EXA_API_KEY=
BRAVE_API_KEY=

# Optional: install location and repo slug used by install.sh
# EFKA_TARGET=$HOME/Efka Engineering System
# EFKA_PROFILE=core
# EFKA_REPO_SLUG=EfkaStudio-prd/Efka-Engineering-System
