{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "paper": "#f7f8ff",
    "panel": "#ffffff",
    "panelSoft": "#fafbff",
    "ink": "#15182c",
    "muted": "#69708a",
    "line": "#dce0f0",
    "lineStrong": "#c9cee4",
    "cyan": "#00aeca",
    "cyanSoft": "#dff9fc",
    "purple": "#7756e8",
    "purpleSoft": "#eee8ff",
    "orange": "#f37b43",
    "green": "#15926d",
    "greenSoft": "#2dc893",
    "paperDark": "#0f1225",
    "panelDark": "#1a1d35",
    "inkDark": "#e8eaf6",
    "mutedDark": "#9aa0b8",
    "lineDark": "#2a2f4a",
    "lineStrongDark": "#3a3f5c"
  },
  "theme": {
    "primary": { "dark": "purple", "light": "purple" },
    "secondary": { "dark": "cyan", "light": "cyan" },
    "accent": { "dark": "cyan", "light": "cyan" },
    "error": { "dark": "orange", "light": "orange" },
    "warning": { "dark": "orange", "light": "orange" },
    "success": { "dark": "green", "light": "green" },
    "info": { "dark": "cyan", "light": "cyan" },
    "text": { "dark": "inkDark", "light": "ink" },
    "textMuted": { "dark": "mutedDark", "light": "muted" },
    "background": { "dark": "paperDark", "light": "paper" },
    "backgroundPanel": { "dark": "panelDark", "light": "panel" },
    "backgroundElement": { "dark": "#232740", "light": "#f0f2fb" },
    "border": { "dark": "lineDark", "light": "line" },
    "borderActive": { "dark": "lineStrongDark", "light": "lineStrong" },
    "borderSubtle": { "dark": "lineDark", "light": "line" },
    "diffAdded": { "dark": "green", "light": "green" },
    "diffRemoved": { "dark": "orange", "light": "orange" },
    "diffContext": { "dark": "mutedDark", "light": "muted" },
    "diffHunkHeader": { "dark": "mutedDark", "light": "muted" },
    "diffHighlightAdded": { "dark": "greenSoft", "light": "green" },
    "diffHighlightRemoved": { "dark": "orange", "light": "orange" },
    "diffAddedBg": { "dark": "#1a2e26", "light": "#e6f4ed" },
    "diffRemovedBg": { "dark": "#3a1f1f", "light": "#fde8e8" },
    "diffContextBg": { "dark": "panelDark", "light": "panelSoft" },
    "diffLineNumber": { "dark": "mutedDark", "light": "#b4b8c8" },
    "diffAddedLineNumberBg": { "dark": "#1e3a2f", "light": "#d1f0de" },
    "diffRemovedLineNumberBg": { "dark": "#3d2424", "light": "#f9dada" },
    "markdownText": { "dark": "inkDark", "light": "ink" },
    "markdownHeading": { "dark": "purple", "light": "purple" },
    "markdownLink": { "dark": "cyan", "light": "cyan" },
    "markdownLinkText": { "dark": "cyanSoft", "light": "cyanSoft" },
    "markdownCode": { "dark": "green", "light": "green" },
    "markdownBlockQuote": { "dark": "mutedDark", "light": "muted" },
    "markdownEmph": { "dark": "orange", "light": "orange" },
    "markdownStrong": { "dark": "purple", "light": "purple" },
    "markdownHorizontalRule": { "dark": "lineDark", "light": "line" },
    "markdownListItem": { "dark": "cyan", "light": "purple" },
    "markdownListEnumeration": { "dark": "cyan", "light": "cyan" },
    "markdownImage": { "dark": "purple", "light": "purple" },
    "markdownImageText": { "dark": "mutedDark", "light": "muted" },
    "markdownCodeBlock": { "dark": "inkDark", "light": "ink" },
    "syntaxComment": { "dark": "mutedDark", "light": "muted" },
    "syntaxKeyword": { "dark": "purple", "light": "purple" },
    "syntaxFunction": { "dark": "cyan", "light": "cyan" },
    "syntaxVariable": { "dark": "inkDark", "light": "ink" },
    "syntaxString": { "dark": "green", "light": "green" },
    "syntaxNumber": { "dark": "orange", "light": "orange" },
    "syntaxType": { "dark": "cyan", "light": "cyan" },
    "syntaxOperator": { "dark": "purple", "light": "purple" },
    "syntaxPunctuation": { "dark": "muted", "light": "muted" }
  }
}
